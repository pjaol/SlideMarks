<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>SlideMarks</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <background file="logo.tiff" alignment="bottomleft" scaling="none"/>
  <background-darkAqua file="logo.tiff" alignment="bottomleft" scaling="none"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_localSystem="true"/>
  <choices-outline><line choice="default"><line choice="slidemarks"/></line></choices-outline>
  <choice id="default"/>
  <choice id="slidemarks" visible="false"><pkg-ref id="{{PKG_ID}}"/></choice>
  <pkg-ref id="{{PKG_ID}}" version="{{VERSION}}" onConclusion="none">slidemarks.pkg</pkg-ref>
</installer-gui-script>
